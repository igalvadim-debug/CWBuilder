      "widgets_values": [
        "{\"v\": 1, \"title\": \"FLUX 3 Image Klein Edit\", \"subtitle\": \"Say what to change, and FLUX 3 Klein edits your picture.\", \"author\": \"AusBoss\", \"layout\": \"card\", \"accent\": \"\", \"body\": \"1. Load your image.\\n2. Say the change, then what stays the same.\\n3. Run.\\n\\n### Tips\\n\\n- Say what stays, like \\\"Keep her face, her clothes, the train and the night exactly the same.\\\" Without it, a big change can do more than you asked, like turning night into day.\\n- Ask for the change. Don't describe the whole picture: a full description redraws the scene, with a new pose and framing.\\n- A big style change, like a painting, can move the picture a little, so the slider won't line up exactly.\\n- LoRAs made for FLUX 3 Klein go in **LoRA Loader**.\\n\\n### The files\\n\\nThey're on Hugging Face behind a license click. Open the [FLUX 3 Klein page](https://huggingface.co/black-forest-labs/flux-3-image-klein-comfy), sign in and accept, then the Download buttons below work.\\n\\nThese are the INT8 files. Black Forest Labs says they run on cards with 8 GB. The BF16 files under them are the full-size version for bigger cards: pick them in **Diffusion model** and **Text encoder**.\\n\\nNeeds ComfyUI 0.41.0 or newer and AusBoss nodes 2.13.0 or newer.\", \"models\": [{\"name\": \"flux3-image-klein-int8-convrot.safetensors\", \"dir\": \"diffusion_models\", \"size\": \"5.83 GB\", \"url\": \"https://huggingface.co/black-forest-labs/flux-3-image-klein-comfy/resolve/main/diffusion_models/flux3-image-klein-int8-convrot.safetensors\", \"note\": \"\"}, {\"name\": \"qwen3vl_4b_int8_convrot.safetensors\", \"dir\": \"text_encoders\", \"size\": \"4.86 GB\", \"url\": \"https://huggingface.co/black-forest-labs/flux-3-image-klein-comfy/resolve/main/text_encoders/qwen3vl_4b_int8_convrot.safetensors\", \"note\": \"\"}, {\"name\": \"flux2-vae.safetensors\", \"dir\": \"vae\", \"size\": \"336 MB\", \"url\": \"https://huggingface.co/black-forest-labs/flux-3-image-klein-comfy/resolve/main/vae/flux2-vae.safetensors\", \"note\": \"\"}, {\"name\": \"flux3-image-klein-bf16.safetensors\", \"dir\": \"diffusion_models\", \"size\": \"11.1 GB\", \"url\": \"https://huggingface.co/black-forest-labs/flux-3-image-klein-comfy/resolve/main/diffusion_models/flux3-image-klein-bf16.safetensors\", \"note\": \"optional: the full-size file, pick it in Diffusion model\"}, {\"name\": \"qwen3vl_4b_bf16.safetensors\", \"dir\": \"text_encoders\", \"size\": \"8.88 GB\", \"url\": \"https://huggingface.co/black-forest-labs/flux-3-image-klein-comfy/resolve/main/text_encoders/qwen3vl_4b_bf16.safetensors\", \"note\": \"optional: the full-size file, pick it in Text encoder\"}], \"packs\": [{\"name\": \"ComfyUI-AusBoss\", \"url\": \"https://github.com/ausboss/ComfyUI-AusBoss\", \"node\": \"AUSBOSS_NODES_Callout\"}], \"links\": [{\"label\": \"YouTube · ausbossdev\", \"url\": \"https://www.youtube.com/@ausbossdev\"}, {\"label\": \"FLUX 3 Klein files · Hugging Face\", \"url\": \"https://huggingface.co/black-forest-labs/flux-3-image-klein-comfy\"}, {\"label\": \"GitHub · ausboss\", \"url\": \"https://github.com/ausboss\"}, {\"label\": \"Civitai · AusBoss\", \"url\": \"https://civitai.com/user/AusBoss\"}, {\"label\": \"X · Zanzibased\", \"url\": \"https://x.com/Zanzibased\"}]}"
      ],
      "widgets_values_named": {
        "note": "{\"v\": 1, \"title\": \"FLUX 3 Image Klein Edit\", \"subtitle\": \"Say what to change, and FLUX 3 Klein edits your picture.\", \"author\": \"AusBoss\", \"layout\": \"card\", \"accent\": \"\", \"body\": \"1. Load your image.\\n2. Say the change, then what stays the same.\\n3. Run.\\n\\n### Tips\\n\\n- Say what stays, like \\\"Keep her face, her clothes, the train and the night exactly the same.\\\" Without it, a big change can do more than you asked, like turning night into day.\\n- Ask for the change. Don't describe the whole picture: a full description redraws the scene, with a new pose and framing.\\n- A big style change, like a painting, can move the picture a little, so the slider won't line up exactly.\\n- LoRAs made for FLUX 3 Klein go in **LoRA Loader**.\\n\\n### The files\\n\\nThey're on Hugging Face behind a license click. Open the [FLUX 3 Klein page](https://huggingface.co/black-forest-labs/flux-3-image-klein-comfy), sign in and accept, then the Download buttons below work.\\n\\nThese are the INT8 files. Black Forest Labs says they run on cards with 8 GB. The BF16 files under them are the full-size version for bigger cards: pick them in **Diffusion model** and **Text encoder**.\\n\\nNeeds ComfyUI 0.41.0 or newer and AusBoss nodes 2.13.0 or newer.\", \"models\": [{\"name\": \"flux3-image-klein-int8-convrot.safetensors\", \"dir\": \"diffusion_models\", \"size\": \"5.83 GB\", \"url\": \"https://huggingface.co/black-forest-labs/flux-3-image-klein-comfy/resolve/main/diffusion_models/flux3-image-klein-int8-convrot.safetensors\", \"note\": \"\"}, {\"name\": \"qwen3vl_4b_int8_convrot.safetensors\", \"dir\": \"text_encoders\", \"size\": \"4.86 GB\", \"url\": \"https://huggingface.co/black-forest-labs/flux-3-image-klein-comfy/resolve/main/text_encoders/qwen3vl_4b_int8_convrot.safetensors\", \"note\": \"\"}, {\"name\": \"flux2-vae.safetensors\", \"dir\": \"vae\", \"size\": \"336 MB\", \"url\": \"https://huggingface.co/black-forest-labs/flux-3-image-klein-comfy/resolve/main/vae/flux2-vae.safetensors\", \"note\": \"\"}, {\"name\": \"flux3-image-klein-bf16.safetensors\", \"dir\": \"diffusion_models\", \"size\": \"11.1 GB\", \"url\": \"https://huggingface.co/black-forest-labs/flux-3-image-klein-comfy/resolve/main/diffusion_models/flux3-image-klein-bf16.safetensors\", \"note\": \"optional: the full-size file, pick it in Diffusion model\"}, {\"name\": \"qwen3vl_4b_bf16.safetensors\", \"dir\": \"text_encoders\", \"size\": \"8.88 GB\", \"url\": \"https://huggingface.co/black-forest-labs/flux-3-image-klein-comfy/resolve/main/text_encoders/qwen3vl_4b_bf16.safetensors\", \"note\": \"optional: the full-size file, pick it in Text encoder\"}], \"packs\": [{\"name\": \"ComfyUI-AusBoss\", \"url\": \"https://github.com/ausboss/ComfyUI-AusBoss\", \"node\": \"AUSBOSS_NODES_Callout\"}], \"links\": [{\"label\": \"YouTube · ausbossdev\", \"url\": \"https://www.youtube.com/@ausbossdev\"}, {\"label\": \"FLUX 3 Klein files · Hugging Face\", \"url\": \"https://huggingface.co/black-forest-labs/flux-3-image-klein-comfy\"}, {\"label\": \"GitHub · ausboss\", \"url\": \"https://github.com/ausboss\"}, {\"label\": \"Civitai · AusBoss\", \"url\": \"https://civitai.com/user/AusBoss\"}, {\"label\": \"X · Zanzibased\", \"url\": \"https://x.com/Zanzibased\"}]}"
