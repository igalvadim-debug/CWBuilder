.\n\n\n2-3 extensions are feasible, then quality starts to collapse. Make sure the last frame is a good one, as it will impact quality of further extended clips.\n\nYou still need to stitch the generated clips together with a video editor tool of your choice.\n\n\nSince a new workflow will be created for each new clip, you can delete them afterwards or keep them to go back to any previous generation within a session. Alternatively you can just copy last frame image and paste it to Input Image to keep everything in the same worflow.\n\n"],"color":"#432","bgcolor":"#653"},{"id":282,"type":"ShowText|pysssss","pos":[2040,360],"size":[920,160],"flags":{"collapsed":false,"pinned":true},"order":31,"mode":0,"inputs":[{"localized_name":"text","name":"text","type":"STRING","pos":[10,36],"link":444}],"outputs":[{"localized_name":"STRING","name":"STRING","shape":6,"type":"STRING","links":null}],"title":"Prompt applied","properties":{"cnr_id":"comfyui-custom-scripts","ver":"bbda5e52ad580c13ceaa53136d9c2bed9137bd2e","Node name for S&R":"ShowText|pysssss"},"widgets_values":[],"color":"#232","bgcolor":"#353"},{"id":352,"type":"Note","pos":[840,-680],"size":[260,120],"flags":{},"order":10,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["LTX 0.9.6\n\nfixed values:\n- CFG is managed in STG Guider node\n"],"color":"#432","bgcolor":"#653"},{"id":300,"type":"VAEDecodeTiled","pos":[880,80],"size":[240,150],"flags":{},"order":37,"mode":0,"inputs":[{"localized_name":"samples","name":"samples","type":"LATENT","link":487},{"localized_name":"vae","name":"vae","type":"VAE","link":573},{"localized_name":"tile_size","name":"tile_size","type":"INT","widget":{"name":"tile_size"},"link":null},{"localized_name":"overlap","name":"overlap","type":"INT","widget":{"name":"overlap"},"link":null},{"localized_name":"temporal_size","name":"temporal_size","type":"INT","widget":{"name":"temporal_size"},"link":null},{"localized_name":"temporal_overlap","name":"temporal_overlap","type":"INT",